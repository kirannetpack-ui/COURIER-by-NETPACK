APP_NAME="Courier by NETPACK"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://courier.example.com
APP_TIMEZONE=Asia/Kathmandu

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=netpack_production
DB_USERNAME=netpack_app
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=postmark
MAIL_FROM_ADDRESS=notifications@example.com
MAIL_FROM_NAME="${APP_NAME}"
POSTMARK_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

KHALTI_LIVE=true
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=
ESEWA_LIVE=true
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=

ALLOW_DEMO_SEEDING=false
